{
  "name": "business-service",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "build": "npm install",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "migration:run": "node -e \"require('./src/config/database').AppDataSource.initialize().then(ds => ds.runMigrations().then(() => process.exit(0))).catch(console.error)\"",
    "migration:revert": "node -e \"require('./src/config/database').AppDataSource.initialize().then(ds => ds.undoLastMigration().then(() => process.exit(0))).catch(console.error)\"",
    "migration:check": "node check-migrations.js"
  },
  "dependencies": {
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "pg": "^8.11.0",
    "reflect-metadata": "^0.1.13",
    "typeorm": "^0.3.17"
  },
  "devDependencies": {
    "fast-check": "^4.9.0",
    "jest": "^30.5.1",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2"
  }
}
