# Local development config (NODE_ENV=development loads this file)
# This file is gitignored. See .env.example for the template.
PORT=3000

# PostgreSQL connection (local).
DATABASE_URL=postgresql://postgres:Root@localhost:5432/naya_nava_vyapaar

# SSL: keep false for local PostgreSQL. Set true for a managed/remote DB
# (Supabase, Render Postgres) that requires SSL.
DB_SSL=false

# Schema sync: true creates/updates tables from entities. Keep true for first
# run on a fresh DB; set false in production once the schema exists so the
# client's data schema is never auto-altered. Unset = on in dev, off in prod.
DB_SYNC=true

# Discrete parts (used only if DATABASE_URL is unset):
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=Root
# DB_NAME=naya_nava_vyapaar

JWT_SECRET=14b2a3bcfd64e5e07598f62a92a366746bd5248ca1a9d692ccdfd5ef7d27cbf3575faa17ec0fe6b4651862fecce6cdeb9d7bae18a1fbe3a99d9a23fdd3504e12
JWT_REFRESH_SECRET=0f2952ad79cbe8e7870f8f12575875bbc574930d4f9941f0c3ead07907dd09c6a3a7ffaab6e2d2e7696640c10aded111460a76c060e67ffb7efe5308fbb26cb3
